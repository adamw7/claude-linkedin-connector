# Settings for compose.yaml. Copy to .env (chmod 600: it holds secrets) and fill in.
# All other variables in the main .env.example and the README work here too.

# The domain the connector is served on. Point its DNS A/AAAA records at this machine first;
# Caddy then gets a certificate for it. Claude connects to https://<DOMAIN>/mcp.
DOMAIN=linkedin-mcp.example.com

# From the Auth tab of your app at https://www.linkedin.com/developers/apps.
# Add https://<DOMAIN>/oauth/callback to its authorized redirect URLs.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Generate once with: openssl rand -base64 32. Keep it: changing it disconnects everyone.
SERVER_SECRET=

# The LinkedIn emails or member IDs allowed to connect, comma-separated, or * for anyone.
LINKEDIN_ALLOWED_MEMBERS=

# Pin a version instead of following the latest release, e.g. ghcr.io/adamw7/claude-linkedin-connector:0.4.0
# CONNECTOR_IMAGE=ghcr.io/adamw7/claude-linkedin-connector:latest
