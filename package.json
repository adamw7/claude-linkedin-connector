{
  "name": "claude-linkedin-connector",
  "version": "0.1.0",
  "description": "MCP connector that lets Claude read your LinkedIn profile and publish, manage and engage with LinkedIn posts.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "linkedin",
    "connector"
  ],
  "homepage": "https://github.com/adamw7/claude-linkedin-connector#readme",
  "bugs": {
    "url": "https://github.com/adamw7/claude-linkedin-connector/issues"
  },
  "license": "MIT",
  "author": "Adam Witkowski (https://github.com/adamw7)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamw7/claude-linkedin-connector.git"
  },
  "type": "module",
  "bin": {
    "claude-linkedin-connector": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "setup": "node scripts/setup-claude-code.mjs",
    "bundle": "node scripts/bundle.mjs",
    "pack:mcpb": "npm run bundle && mcpb pack mcpb claude-linkedin-connector.mcpb",
    "test:mutation": "node scripts/patch-stryker-vitest.mjs && stryker run"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "archunit": "^2.5.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
