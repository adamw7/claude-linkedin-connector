# --- LinkedIn app (both modes) -------------------------------------------
# From the Auth tab of your app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Secrets can also come from a file (Docker and Kubernetes secrets): set
# LINKEDIN_CLIENT_SECRET_FILE, SERVER_SECRET_FILE or SERVER_SECRET_PREVIOUS_FILE to its path instead.
# Turn on only if your app has the Community Management API product:
# comments and reactions, and acting as LinkedIn Pages you administer.
# LINKEDIN_COMMENTS=true
# LINKEDIN_PAGES=true
# Permissions to request (the two settings above add to them).
# LINKEDIN_SCOPES=openid profile email w_member_social
# Pin a LinkedIn API version (YYYYMM). By default the connector uses a recent
# version and switches automatically when LinkedIn retires it.
# LINKEDIN_API_VERSION=202609

# --- Local mode (stdio: Claude Desktop / Claude Code) -----------------------
# Must exactly match an authorized redirect URL in your LinkedIn app.
# LINKEDIN_REDIRECT_URI=http://localhost:8723/callback
# Where the token is stored (default: ~/.config/claude-linkedin-connector/token.json).
# LINKEDIN_TOKEN_FILE=
# Skip the sign-in flow and use this token directly.
# LINKEDIN_ACCESS_TOKEN=
# Comma-separated folders tools may read local images, documents and Connections.csv from
# (default: ~/Downloads, ~/Desktop, ~/Pictures and the working directory unless it contains your home).
# LINKEDIN_FILE_DIRS=

# --- Remote mode (http: claude.ai custom connector) -------------------------
# Public origin of the server. Add <PUBLIC_URL>/oauth/callback to your
# LinkedIn app's authorized redirect URLs.
# PUBLIC_URL=https://linkedin-mcp.example.com
# Signs and encrypts OAuth tokens; changing it disconnects everyone. Required unless
# PUBLIC_URL is localhost. Generate once with: openssl rand -base64 32
SERVER_SECRET=
# To rotate it without disconnecting anyone: put the old secret here and a new one in
# SERVER_SECRET; remove this after 60 days (see docs/deployment.md).
# SERVER_SECRET_PREVIOUS=
# HOST=127.0.0.1
# PORT=3000
# Required: the LinkedIn accounts allowed to connect (emails or member IDs,
# comma-separated), or * for anyone. Optional when PUBLIC_URL is localhost.
LINKEDIN_ALLOWED_MEMBERS=
# Redirect URIs OAuth clients may register (default: Claude's callbacks + localhost).
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,loopback
# Reject requests whose Host header is not listed (comma-separated hostnames).
# ALLOWED_HOSTS=
# Number of proxies in front of the server (or true, or subnets), so client IPs
# are read from X-Forwarded-For. Without it, everyone shares the proxy's rate limit.
# TRUST_PROXY=1
# Requests per minute per client IP to the OAuth endpoints, and per connected
# account to /mcp. 0 disables.
# RATE_LIMIT_OAUTH=60
# RATE_LIMIT_MCP=120
# Seconds to let in-flight requests finish on shutdown.
# SHUTDOWN_TIMEOUT=8
# Seconds idle connections stay open. Keep it above the upstream idle timeout of the
# proxy or load balancer in front (e.g. 620 on Google Cloud), or some requests get 502.
# KEEP_ALIVE_TIMEOUT=65
